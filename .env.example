# ===========================================
# SAFRA - Environment Variables Configuration
# ===========================================

# -------------------------------------------
# MySQL Database Configuration
# -------------------------------------------
MYSQL_HOST=your-mysql-host.com
MYSQL_PORT=3306
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=safra_db

# -------------------------------------------
# Email Configuration (Google Workspace SMTP)
# -------------------------------------------
# For Google Workspace, you need to generate an App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Sign in with your Google Workspace account
# 3. Select "Mail" as the app and your device
# 4. Copy the 16-character app password generated
# 5. Use that password below (NOT your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=akram@tydalmachine.dz
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=akram@tydalmachine.dz
SMTP_FROM_NAME=Safra

# -------------------------------------------
# SATIM Payment Gateway Configuration
# (To be provided later)
# -------------------------------------------
SATIM_TERMINAL_ID=
SATIM_MERCHANT_ID=
SATIM_SECRET_KEY=
SATIM_API_URL=https://test.satim.dz/payment/rest

# -------------------------------------------
# Application Configuration
# -------------------------------------------
NEXT_PUBLIC_BASE_URL=https://safra.dz
NODE_ENV=production

# -------------------------------------------
# Session Configuration
# -------------------------------------------
# Secret key for signing session tokens (generate a random 32+ char string)
SESSION_SECRET=your-very-long-random-secret-key-here
